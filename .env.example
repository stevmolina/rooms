# Copy to .env for local runs. Never commit real values.
# Set WORKOS_API_KEY in the environment. Do not commit it.

# workos (real sign-in) or dev (static tokens, local only)
AUTH_MODE=workos
MCP_BASE_URL=https://rooms.mcpbox.dev
AUTHKIT_DOMAIN=https://your-tenant.authkit.app
WORKOS_API_KEY=
WORKOS_CLIENT_ID=

# SQLite file. In the container this is /data/rooms.db (a volume).
ROOMS_DB=./data/rooms.db
# Set false only for plain http on localhost.
COOKIE_SECURE=true
LOG_LEVEL=INFO

# Dev only (AUTH_MODE=dev): token:sub:email:Name,...
# DEV_TOKENS=dev-alice:alice:alice@example.com:Alice
